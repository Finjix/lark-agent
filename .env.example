FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Comma-separated tenant keys. Set to allow every user in these enterprises.
# When set, tenant membership replaces the per-user allowlist and also restricts admins.
ALLOWED_TENANTS=
# Comma-separated Open IDs. Used when ALLOWED_TENANTS is empty.
# Leaving tenants, users, and admins all empty denies all new tasks.
ALLOWED_USERS=
ADMIN_USERS=
# Empty chat list permits private chats and groups for allowed users.
ALLOWED_CHATS=
DATABASE_PATH=./data/agent.sqlite
CARD_UPDATE_INTERVAL_MS=5000
TASK_TIMEOUT_MS=0
# Logs, workspace files and the agent's chats nobody has touched for this many days are deleted automatically (see README).
RETENTION_DAYS=14
HEALTH_PORT=8765
# JSON object mapping resource names to regular expressions matching task text.
RESOURCE_LOCKS={}
# The pi coding agent runs in the service and keeps its state (the ChatGPT login, the chats) in <project>/data/pi; the system's ~/.pi is not touched.
# It signs in with a ChatGPT Plus/Pro subscription: run `start.cmd login` once. Model and reasoning effort (off, minimal, low, medium, high, xhigh, max):
AGENT_PROVIDER=openai-codex
AGENT_MODEL=gpt-6.1-sol
AGENT_THINKING=medium
# The audit-auto skill reviews videos with Gemini through the internal AI gateway (Lumos): its key.
AUDIT_AUTO_GEMINI_KEY=
# Optional: what the log file in data/logs keeps: debug, info (default), warn or error. The console shows only the start and submitted tasks.
LOG_LEVEL=
