FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Comma-separated tenant keys. Set to allow every user in these enterprises.
# When set, tenant membership replaces the per-user allowlist and also restricts admins.
ALLOWED_TENANTS=
# Comma-separated Open IDs. Used when ALLOWED_TENANTS is empty.
# Leaving tenants, users, and admins all empty denies all new tasks.
ALLOWED_USERS=
ADMIN_USERS=
# Empty chat list permits private chats and groups for allowed users.
ALLOWED_CHATS=
DATABASE_PATH=./data/agent.sqlite
CARD_UPDATE_INTERVAL_MS=1000
TASK_TIMEOUT_MS=0
TASK_RETENTION_DAYS=30
HEALTH_PORT=8765
# JSON object mapping resource names to regular expressions matching task text.
RESOURCE_LOCKS={}
# Codex runs through its SDK and keeps everything (chats, generated images) in <project>/.codex; the system's own Codex is not touched.
# There is no key here: every user sends their own OpenAI API key to the bot once, with /key.
# Optional: model and reasoning effort of Codex. Empty uses Codex's own defaults.
CODEX_MODEL=
CODEX_REASONING_EFFORT=
# Optional: debug, info (default), warn or error.
LOG_LEVEL=
