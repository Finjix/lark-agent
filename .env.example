FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Comma-separated tenant keys. Set to allow every user in these enterprises.
# When set, tenant membership replaces the per-user allowlist and also restricts admins.
ALLOWED_TENANTS=
# Comma-separated Open IDs. Used when ALLOWED_TENANTS is empty.
# Leaving tenants, users, and admins all empty denies all new tasks.
ALLOWED_USERS=
ADMIN_USERS=
# Empty chat list permits private chats and groups for allowed users.
ALLOWED_CHATS=
DATABASE_PATH=./data/agent.sqlite
CARD_UPDATE_INTERVAL_MS=1000
DESKTOP_CONNECT_TIMEOUT_MS=10000
TASK_TIMEOUT_MS=0
TASK_RETENTION_DAYS=30
HEALTH_PORT=8765
# JSON object mapping resource names to regular expressions matching task text.
RESOURCE_LOCKS={}
# Optional: Codex Desktop data directory. Defaults to ~/.codex.
CODEX_HOME=
# Optional: debug, info (default), warn or error.
LOG_LEVEL=
# Per-user headless browser (Playwright). 0 turns the feature off.
BROWSER_ENABLED=1
# Installed browser to drive: msedge (default), chrome, or set BROWSER_EXECUTABLE to an explicit path.
BROWSER_CHANNEL=msedge
BROWSER_EXECUTABLE=
# Close a user's idle browser after this many ms (profile and cookies are kept).
BROWSER_IDLE_MS=600000
# Feishu CLI (official lark-cli) with per-user login stored under user/<session>/feishu-cli. 0 turns the feature off.
FEISHU_CLI_ENABLED=1
# Comma-separated user scopes requested at login, e.g. docx:document,drive:drive,calendar:calendar.
# Empty (default): documents (create/read/edit), calendar read-only, mailbox read-only. Set `all` to request every user scope the app has been granted.
# Further scopes are requested on demand with `auth login --scope`. The app must have them enabled in the Feishu developer console;
# offline_access is always added.
FEISHU_CLI_SCOPES=
# Optional: explicit path to lark-cli. Defaults to the copy installed in node_modules.
FEISHU_CLI_PATH=
